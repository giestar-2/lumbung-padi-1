<mxCell id="legend" value="&lt;b&gt;Cara membaca diagram&lt;/b&gt;&lt;br&gt;PK = primary key; FK = foreign key; UK = unique; N = boleh NULL.&lt;br&gt;Garis utuh = constraint database. Garis putus-putus oranye = referensi yang dikelola kode.&lt;br&gt;Label 1 : 0..N berarti satu baris induk dapat mempunyai nol atau banyak baris anak.&lt;br&gt;Halaman ini menampilkan kolom utama. Detail seluruh kolom tersedia di halaman 2–5." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=12;fontFamily=Helvetica;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="1840" y="180" width="450" height="200" as="geometry"/></mxCell>
<mxCell id="owner-note" value="&lt;b&gt;Akses owner&lt;/b&gt;&lt;br&gt;users tidak mempunyai relasi owner_id ke tabel bisnis. Aplikasi saat ini memakai satu ruang data bisnis bersama dan membatasi akses lewat Gate owner." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=12;fontFamily=Helvetica;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="340" height="135" as="geometry"/></mxCell></root></mxGraphModel></diagram>
