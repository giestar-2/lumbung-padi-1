<mxCell id="session-user-reference" value="Referensi user_id (nullable; hanya indeks, tanpa FK)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.5;strokeColor=#C2410C;fontColor=#C2410C;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;startArrow=none;endArrow=open;" edge="1" parent="logical" source="users.id" target="sessions.user_id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="reset-email-reference" value="Referensi email; bukan foreign key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.5;strokeColor=#C2410C;fontColor=#C2410C;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;startArrow=none;endArrow=open;" edge="1" parent="logical" source="users.email" target="password_reset_tokens.email"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="support-notes" value="&lt;b&gt;Tabel pendukung&lt;/b&gt;&lt;br&gt;sessions dipakai jika SESSION_DRIVER=database. cache/cache_locks dipakai jika CACHE_STORE=database.&lt;br&gt;cache_versions selalu menyimpan revision domain business untuk kunci SummaryCache.&lt;br&gt;jobs/job_batches/failed_jobs tersedia untuk antrean; pemakaian mengikuti QUEUE_CONNECTION.&lt;br&gt;migrations mencatat migration yang telah dijalankan.&lt;br&gt;Garis putus-putus menyatakan referensi logis, bukan constraint SQL." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=12;fontFamily=Helvetica;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="60" y="1430" width="1040" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="workflow" name="6. Workflow dan perubahan tabel"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="physical" value="Foreign key database" parent="0"/>
<mxCell id="logical" value="Referensi workflow (tanpa foreign key)" parent="0"/>
<mxCell id="title" value="6. Workflow dan perubahan tabel" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#00478A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1750" height="45" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Lumbung Beras | MySQL lumbung_beras | Schema dan workflow diperiksa 8 Oktober 2026" style="text;html=1;align=left;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="50" y="82" width="1750" height="30" as="geometry"/></mxCell>
<mxCell id="flow-title-0" value="&lt;b&gt;PENJUALAN DAN PIUTANG&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=12;fontFamily=Helvetica;fontColor=#334155;fillColor=#EFF6FF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="1720" height="45" as="geometry"/></mxCell>
<mxCell id="step-1" value="&lt;b&gt;1. Konfirmasi POS&lt;/b&gt;&lt;br&gt;Validasi produk aktif, stok, kg, diskon, pelanggan dan nominal bayar. Harga/modal dibaca dari database." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-2" value="&lt;b&gt;2. Buat nota&lt;/b&gt;&lt;br&gt;sales + sale_items.&lt;br&gt;Simpan snapshot nama, kategori, harga dan HPP.&lt;br&gt;Kurangi products.stock_kg dan inventory_value." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="240" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-3" value="&lt;b&gt;3. Catat uang diterima&lt;/b&gt;&lt;br&gt;Jika paid_amount &amp;gt; 0:&lt;br&gt;payments(is_initial=true) + cash_entries(Pemasukan).&lt;br&gt;Bayar 0: tanpa catatan kas." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="240" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-4" value="&lt;b&gt;4. Perbarui piutang&lt;/b&gt;&lt;br&gt;customers.receivable_balance dihitung kembali.&lt;br&gt;Sisa nota = total − paid_amount.&lt;br&gt;Ringkasan cache mendapat revision baru." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="240" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-5" value="&lt;b&gt;5. Pembayaran lanjutan&lt;/b&gt;&lt;br&gt;payments + cash_entries baru.&lt;br&gt;Perbarui sales.paid_amount/status dan piutang pelanggan.&lt;br&gt;Stok tidak dikurangi lagi." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1500" y="240" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="flow-step-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-1" target="step-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-2" target="step-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-3" target="step-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-4" target="step-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-title-5" value="&lt;b&gt;PEMBELIAN DAN STOK PRODUK&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=12;fontFamily=Helvetica;fontColor=#334155;fillColor=#EEF4FF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="1720" height="45" as="geometry"/></mxCell>
<mxCell id="step-6" value="&lt;b&gt;1. Pembelian stok&lt;/b&gt;&lt;br&gt;Tambah produk: stok awal + total belanja.&lt;br&gt;Tambah stok: kg masuk + total belanja opsional." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#EEF4FF;strokeColor=#00478A;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-7" value="&lt;b&gt;2. Nilai pembelian&lt;/b&gt;&lt;br&gt;Total kosong pada stok masuk memakai modal/kg saat ini.&lt;br&gt;Total 0 diterima sebagai stok tanpa biaya." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#EEF4FF;strokeColor=#00478A;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="650" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-8" value="&lt;b&gt;3. Modal rata-rata&lt;/b&gt;&lt;br&gt;Stok baru = stok lama + stok masuk.&lt;br&gt;Nilai baru = modal stok lama + belanja.&lt;br&gt;Modal/kg = nilai baru ÷ stok baru." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#EEF4FF;strokeColor=#00478A;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="650" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-9" value="&lt;b&gt;4. Simpan produk&lt;/b&gt;&lt;br&gt;products.stock_kg&lt;br&gt;products.inventory_value&lt;br&gt;products.cogs_per_kg&lt;br&gt;Detail produk tidak mengubah modal langsung." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#EEF4FF;strokeColor=#00478A;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="650" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-10" value="&lt;b&gt;5. Kas pembelian&lt;/b&gt;&lt;br&gt;Jika total belanja &amp;gt; 0: cash_entries(Pengeluaran, Persediaan).&lt;br&gt;reference_type = Product::class.&lt;br&gt;Total 0 tidak membuat kas." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#EEF4FF;strokeColor=#00478A;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1500" y="650" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="flow-step-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-6" target="step-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-7" target="step-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-8" target="step-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-9" target="step-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-title-10" value="&lt;b&gt;PEMBAYARAN GAJI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=12;fontFamily=Helvetica;fontColor=#334155;fillColor=#F5F3FF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="1720" height="45" as="geometry"/></mxCell>
<mxCell id="step-11" value="&lt;b&gt;1. Pilih karyawan&lt;/b&gt;&lt;br&gt;Kartu karyawan aktif dengan gaji harian.&lt;br&gt;Atur hari kerja dan periode.&lt;br&gt;Tarif dibaca dari employees." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1060" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-12" value="&lt;b&gt;2. Validasi keranjang&lt;/b&gt;&lt;br&gt;Hari kerja sesuai periode.&lt;br&gt;Pembayaran serupa meminta konfirmasi.&lt;br&gt;Produksi terkunci tidak menerima biaya baru." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="1060" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-13" value="&lt;b&gt;3. Simpan gaji&lt;/b&gt;&lt;br&gt;Satu payrolls per karyawan.&lt;br&gt;daily_rate + work_days + total_amount.&lt;br&gt;Status Sudah Dibayar.&lt;br&gt;Kunci unik per pembayaran/karyawan." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="1060" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-14" value="&lt;b&gt;4. Catat pengeluaran&lt;/b&gt;&lt;br&gt;Satu cash_entries per payroll.&lt;br&gt;reference_type = Payroll::class.&lt;br&gt;Pembayaran operasional dihitung sebagai biaya gaji." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="1060" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-15" value="&lt;b&gt;5. Biaya produksi&lt;/b&gt;&lt;br&gt;Jika ditujukan ke produksi:&lt;br&gt;payrolls.production_batch_id + cash_entries.production_batch_id + batch_costs terkait kas." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1500" y="1060" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="flow-step-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-11" target="step-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-12" target="step-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-13" target="step-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-14" target="step-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-title-15" value="&lt;b&gt;PRODUKSI BERAS, DEDEK, DAN PUPUK&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=12;fontFamily=Helvetica;fontColor=#334155;fillColor=#ECFDF5;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="60" y="1410" width="1720" height="45" as="geometry"/></mxCell>
<mxCell id="step-16" value="&lt;b&gt;1. Terima bahan&lt;/b&gt;&lt;br&gt;production_batches.&lt;br&gt;source_batch_id/inherited_cost untuk bahan sisa.&lt;br&gt;Pembelian awal ditandai pada batch_costs." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#ECFDF5;strokeColor=#087F5B;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1470" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-17" value="&lt;b&gt;2. Proses dan timbang&lt;/b&gt;&lt;br&gt;batch_stages menyimpan riwayat.&lt;br&gt;production_batches menyimpan tahap, berat kering, hasil, dedek/pupuk dan campuran." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#ECFDF5;strokeColor=#087F5B;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="1470" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-18" value="&lt;b&gt;3. Catat dan bayar biaya&lt;/b&gt;&lt;br&gt;batch_costs menyimpan nominal.&lt;br&gt;Saat dibayar: cash_entries + paid_at + cash_entry_id.&lt;br&gt;Tidak dibayar: belum ada kas keluar." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#ECFDF5;strokeColor=#087F5B;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="1470" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-19" value="&lt;b&gt;4. Bagi modal hasil&lt;/b&gt;&lt;br&gt;cost_allocation(JSON) menyimpan pembagian biaya.&lt;br&gt;cost_finalized_at mengunci modal.&lt;br&gt;Finalisasi tidak membuat kas baru." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#ECFDF5;strokeColor=#087F5B;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="1470" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="step-20" value="&lt;b&gt;5. Terima hasil ke stok&lt;/b&gt;&lt;br&gt;production_outputs + stock_receipts.&lt;br&gt;Tambah stok dan nilai products; hitung modal rata-rata.&lt;br&gt;UK mencegah penerimaan berulang." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontSize=12;fontFamily=Helvetica;fillColor=#ECFDF5;strokeColor=#087F5B;fontColor=#1E293B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1500" y="1470" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="flow-step-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-16" target="step-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-17" target="step-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-18" target="step-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow-step-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=30;strokeWidth=1.3;strokeColor=#64748B;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="physical" source="step-19" target="step-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="workflow-integrity" value="&lt;b&gt;Konsistensi data&lt;/b&gt;&lt;br&gt;DB::transaction membuat perubahan terkait disimpan bersama atau dibatalkan bersama.&lt;br&gt;lockForUpdate digunakan pada data stok, nota, karyawan dan produksi yang sedang diproses.&lt;br&gt;idempotency_key mencegah pengulangan transaksi; request_hash membandingkan isi permintaan penjualan/pembayaran.&lt;br&gt;Cache memakai domain business + revision. Revision dinaikkan oleh event saved/deleted pada model yang dipantau.&lt;br&gt;Pengeluaran pembelian persediaan memengaruhi kas; HPP penjualan menjadi dasar modal barang yang sudah dijual." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=12;fontFamily=Helvetica;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="60" y="1870" width="1720" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
